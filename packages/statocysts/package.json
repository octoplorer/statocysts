{
  "name": "statocysts",
  "type": "module",
  "version": "0.11.2",
  "description": "Notification library for JavaScript",
  "license": "MIT",
  "homepage": "https://github.com/octoplorer/statocysts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoplorer/statocysts.git"
  },
  "bugs": {
    "url": "https://github.com/octoplorer/statocysts/issues"
  },
  "keywords": [
    "notification",
    "shoutrrr",
    "apprise"
  ],
  "imports": {
    "#/services/*": "./src/services/*/index.ts",
    "#/utils": "./src/utils/index.ts",
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    },
    "./browser": {
      "node": "./dist/browser.js",
      "default": "./src/browser.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "browser": "./src/browser.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "browser": "./dist/browser.js"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "defu": "catalog:lib",
    "emailjs": "catalog:lib",
    "ofetch": "catalog:lib",
    "ufo": "catalog:lib",
    "zod": "catalog:lib"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/smtp-server": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "publint": "catalog:ci",
    "smtp-server": "catalog:dev",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  }
}
