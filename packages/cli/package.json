{
  "name": "@statocysts/cli",
  "type": "module",
  "version": "0.4.0",
  "description": "CLI for statocysts notification library",
  "license": "MIT",
  "homepage": "https://github.com/octoplorer/statocysts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octoplorer/statocysts.git"
  },
  "bugs": {
    "url": "https://github.com/octoplorer/statocysts/issues"
  },
  "keywords": [
    "notification",
    "cli",
    "statocysts"
  ],
  "bin": {
    "stato": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=23"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "statocysts": "workspace:*",
    "yargs": "catalog:cli"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "@types/yargs": "catalog:types",
    "tsdown": "catalog:build",
    "typescript": "catalog:dev"
  }
}
